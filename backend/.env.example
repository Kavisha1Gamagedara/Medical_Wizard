# Application
PROJECT_NAME="Medical Wizard - Appointment Manager"
API_V1_STR="/api/v1"

# Database Configuration (Defaults to local SQLite, can be swapped for PostgreSQL)
DATABASE_URL="sqlite:///./appointments.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/medical_wizard_db"

# JWT Authentication
SECRET_KEY="medical-wizard-super-secret-jwt-key-2026-secure-32bytes-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
